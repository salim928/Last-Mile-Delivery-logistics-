# Django Application Settings
APP_NAME=Last-Mile Optimizer
APP_VERSION=1.0.0
DEBUG=True

# Security - CHANGE IN PRODUCTION!
SECRET_KEY=django-insecure-your-super-secret-key-change-in-production-min-50-chars

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite if not set)
# DATABASE_URL=sqlite:///./movva.db
# For PostgreSQL: postgres://user:password@localhost/dbname

# CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Geocoding Service (OpenStreetMap/Nominatim - Free)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MovvaOptimizer/1.0

# Routing Service (OSRM - Free)
OSRM_URL=http://router.project-osrm.org

# File Upload Settings
UPLOAD_DIR=./uploads
POD_IMAGES_DIR=./uploads/pod

# SMS/WhatsApp (Optional - Twilio Free Tier)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Ghana-specific Settings
DEFAULT_COUNTRY=Ghana
DEFAULT_CURRENCY=GHS
FUEL_PRICE_PER_LITER=15.50
MOTORBIKE_FUEL_CONSUMPTION=0.03
VAN_FUEL_CONSUMPTION=0.12
